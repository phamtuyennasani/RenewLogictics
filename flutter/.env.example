# Mobile API — cấu hình môi trường
# Copy file này thành `.env` rồi chỉnh theo môi trường của bạn.

# Base URL backend Laravel (KHÔNG kèm /api/mobile — app tự thêm prefix).
# - iOS Simulator: dùng được https://logictics.local (chung /etc/hosts với Mac).
# - iPhone/Android thật cùng WiFi: trỏ IP LAN của Mac, vd https://192.168.1.102
#   (lấy IP bằng: ipconfig getifaddr en0).
API_BASE_URL=https://logictics.local

# CHỈ bật ở dev khi backend dùng cert self-signed (logictics.local).
# TUYỆT ĐỐI để false ở staging/production.
DEV_ALLOW_BAD_CERT=true

# Ép HTTP Host header khi backend là name-based vhost (vd MAMP) mà ta phải
# gọi qua IP. Để TRỐNG nếu URL đã là domain resolve được. KHÔNG đặt ở production.
API_HOST_HEADER=
