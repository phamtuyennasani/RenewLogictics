# Mobile API — cấu hình môi trường
# Copy file này thành `.env` rồi chỉnh theo môi trường của bạn.

# Base URL backend Laravel (KHÔNG kèm /api/mobile — app tự thêm prefix).
# Local MAMP dùng logictics.local. Khi deploy host thật chỉ đổi dòng này, ví dụ:
# API_BASE_URL=https://api.tenmiencuaban.com
# Khi domain không phải local, DEV_* bên dưới tự bị bỏ qua.
API_BASE_URL=https://logictics.local

# Chỉ có hiệu lực khi debug + backend local.
DEV_ALLOW_BAD_CERT=true

# Android emulator: URL/SNI vẫn là API_BASE_URL, TCP connect tới 10.0.2.2.
# iOS simulator dùng thẳng logictics.local qua hosts của Mac.
# Nếu test trên máy thật, đổi thành IP LAN của Mac: ipconfig getifaddr en0.
# Khi domain không phải local hoặc app build release, cấu hình này tự bị bỏ qua.
DEV_RESOLVE_IP=auto
