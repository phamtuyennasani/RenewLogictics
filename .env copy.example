APP_NAME="BEE Express"
APP_ENV=local
APP_KEY=base64:50dTblSMEWWC1kR0o99aASz/TAUta6qYavbnJXbggak=
APP_DEBUG=true
APP_URL=https://logictics.local

# License domain-lock — Phát hành bằng `php artisan license:issue`
LICENSE_KEY=

# System branding - có thể thay đổi tùy công ty
SYSTEM_NAME="BEE Express"
SYSTEM_SHORT_NAME="BEE Express"
SYSTEM_SLOGAN="Hệ thống quản lý vận chuyển"
SYSTEM_LOGO="" # Đường dẫn logo, để trống = dùng text
SYSTEM_FAVICON="" # Đường dẫn favicon, để trống = dùng mặc định
SYSTEM_VERSION="1.7.0"
# Theme màu chủ đạo — Chỉ cần đổi 2 dòng này để thay đổi màu toàn hệ thống
THEME_PRIMARY_HEX="#3b82f6"
THEME_PRIMARY_DARK="#2563eb"
THEME_ACCENT_HEX="#0ea5e9"


ORDER_CODE_PREFIX=BEE

# Prefix mã hóa đơn & công nợ
INVOICE_CODE_PREFIX_THU=HDTH
INVOICE_CODE_PREFIX_CHI=HDCH
DEBT_CODE_PREFIX=DEB

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

TIMEZONE=Asia/Ho_Chi_Minh

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=newvaupost
DB_USERNAME=root
DB_PASSWORD=root
DB_PREFIX=table_

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Default payment/e-invoice provider used by app-level provider managers.
PAYMENT_PROVIDER_DEFAULT=sepay
EINVOICE_PROVIDER_DEFAULT=sepay

# SePay QR bank transfer settings.
# SEPAY_BANK: receiving bank code, for example VCB/ACB/BIDV.
# SEPAY_ACCOUNT_NUMBER: receiving bank account number.
# SEPAY_ACCOUNT_NAME: receiving bank account holder name, used for display/audit.
# SEPAY_QR_BASE_URL: SePay public QR image endpoint.
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img

# SePay bank webhook verification for /api/webhooks/sepay.
# SEPAY_AUTH_MODE: hmac, apikey, or none. Prefer hmac in production.
# SEPAY_API_KEY: required only when SEPAY_AUTH_MODE=apikey.
# SEPAY_WEBHOOK_SECRET: required when SEPAY_AUTH_MODE=hmac.
# SEPAY_TIMESTAMP_TOLERANCE: accepted timestamp drift in seconds for HMAC verification.
SEPAY_AUTH_MODE=hmac
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_TIMESTAMP_TOLERANCE=300

# SePay Payment Gateway settings for redirect/checkout flows.
# Merchant credentials are provided by SePay.
# Success/error/cancel URLs are app URLs that SePay redirects users back to.
# API/CHECKOUT base URLs can stay empty to use sandbox/production defaults.
SEPAY_GATEWAY_ENV=sandbox
SEPAY_GATEWAY_MERCHANT_ID=
SEPAY_GATEWAY_SECRET_KEY=
SEPAY_GATEWAY_IPN_SECRET_KEY=
SEPAY_GATEWAY_API_BASE_URL=
SEPAY_GATEWAY_CHECKOUT_BASE_URL=
SEPAY_GATEWAY_SUCCESS_URL=
SEPAY_GATEWAY_ERROR_URL=
SEPAY_GATEWAY_CANCEL_URL=

# SePay e-invoice API settings.
# Client credentials are provided by SePay e-invoice.
# Base URL can stay empty to use sandbox/production defaults.
SEPAY_EINVOICE_ENV=sandbox
SEPAY_EINVOICE_CLIENT_ID=
SEPAY_EINVOICE_CLIENT_SECRET=
SEPAY_EINVOICE_BASE_URL=

TRACKINGMORE_API_KEY=
TRACKINGMORE_BASE_URL=https://api.trackingmore.com/v4
TRACKINGMORE_TIMEOUT=20

# Default payment/e-invoice provider used by app-level provider managers.
PAYMENT_PROVIDER_DEFAULT=sepay
EINVOICE_PROVIDER_DEFAULT=sepay

# SePay QR bank transfer settings.
# SEPAY_BANK: receiving bank code, for example VCB/ACB/BIDV.
# SEPAY_ACCOUNT_NUMBER: receiving bank account number.
# SEPAY_ACCOUNT_NAME: receiving bank account holder name, used for display/audit.
# SEPAY_QR_BASE_URL: SePay public QR image endpoint.
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img

# SePay bank webhook verification for /api/webhooks/sepay.
# SEPAY_AUTH_MODE: hmac, apikey, or none. Prefer hmac in production.
# SEPAY_API_KEY: required only when SEPAY_AUTH_MODE=apikey.
# SEPAY_WEBHOOK_SECRET: required when SEPAY_AUTH_MODE=hmac.
# SEPAY_TIMESTAMP_TOLERANCE: accepted timestamp drift in seconds for HMAC verification.
SEPAY_AUTH_MODE=hmac
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_TIMESTAMP_TOLERANCE=300

# SePay Payment Gateway settings for redirect/checkout flows.
# Merchant credentials are provided by SePay.
# Success/error/cancel URLs are app URLs that SePay redirects users back to.
# API/CHECKOUT base URLs can stay empty to use sandbox/production defaults.
SEPAY_GATEWAY_ENV=sandbox
SEPAY_GATEWAY_MERCHANT_ID=
SEPAY_GATEWAY_SECRET_KEY=
SEPAY_GATEWAY_IPN_SECRET_KEY=
SEPAY_GATEWAY_API_BASE_URL=
SEPAY_GATEWAY_CHECKOUT_BASE_URL=
SEPAY_GATEWAY_SUCCESS_URL=
SEPAY_GATEWAY_ERROR_URL=
SEPAY_GATEWAY_CANCEL_URL=

# SePay e-invoice API settings.
# Client credentials are provided by SePay e-invoice.
# Base URL can stay empty to use sandbox/production defaults.
SEPAY_EINVOICE_ENV=sandbox
SEPAY_EINVOICE_CLIENT_ID=
SEPAY_EINVOICE_CLIENT_SECRET=
SEPAY_EINVOICE_BASE_URL=

# MoMo payment gateway settings.
# Get sandbox credentials from https://developers.momo.vn
# MOMO_PARTNER_CODE, MOMO_ACCESS_KEY, MOMO_SECRET_KEY: provided by MoMo.
# MOMO_REDIRECT_URL: URL MoMo redirects user after payment.
# MOMO_IPN_URL: webhook endpoint for payment notifications.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENV=sandbox
MOMO_REDIRECT_URL=${APP_URL}/thanh-toan/momo/return
MOMO_IPN_URL=${APP_URL}/api/webhooks/momo
MOMO_REQUEST_TYPE=captureWallet
MOMO_PARTNER_NAME=
MOMO_STORE_ID=
MOMO_ENDPOINT=

# VNPay payment gateway settings.
# Get sandbox credentials from https://sandbox.vnpayment.vn/apis/
# VNPAY_TMN_CODE: Terminal code provided by VNPay.
# VNPAY_HASH_SECRET: Secret key for signature verification.
# VNPAY_RETURN_URL: URL VNPay redirects user after payment.
# VNPAY_IPN_URL: webhook endpoint for payment notifications.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENV=sandbox
VNPAY_RETURN_URL=${APP_URL}/thanh-toan/vnpay/return
VNPAY_IPN_URL=${APP_URL}/api/webhooks/vnpay
VNPAY_COMMAND=pay
VNPAY_ORDER_TYPE=billpayment
VNPAY_LOCALE=vn
VNPAY_CURRENCY=VND

VITE_APP_NAME="${APP_NAME}"

# VietMap API Key — Get your key at https://maps.vietmap.vn/
VITE_VIETMAP_API_KEY=
